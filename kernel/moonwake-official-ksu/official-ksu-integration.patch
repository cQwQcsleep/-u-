From 211ee50229acc5b1324a26084cda4a1dd065857d Mon Sep 17 00:00:00 2001
From: dev <dev@sandbox>
Date: Fri, 2 Oct 2026 22:13:45 +0000
Subject: [PATCH 1/2] hyperos: add vendor/hyperos.config for MIUI/HyperOS
 compatibility testing

---
 arch/arm64/configs/vendor/hyperos.config | 33 ++++++++++++++++++++++++
 1 file changed, 33 insertions(+)
 create mode 100644 arch/arm64/configs/vendor/hyperos.config

diff --git a/arch/arm64/configs/vendor/hyperos.config b/arch/arm64/configs/vendor/hyperos.config
new file mode 100644
index 000000000000..747c38164705
--- /dev/null
+++ b/arch/arm64/configs/vendor/hyperos.config
@@ -0,0 +1,33 @@
+# HyperOS / MIUI 兼容性候选配置
+#
+# 背景：MoonWake 的 ruby_defconfig 相对原厂关闭了一批 MTK 性能/遥测/调试设施，
+#       而 MIUI/HyperOS 的 power HAL（mtkpower / vendor.mediatek.hardware.power）、
+#       perfmgr、game turbo 与部分 vendor 服务在开机阶段会读写这些节点。
+#       本文件把这些设施恢复为原厂形态，作为"配置层"验证项。
+#
+# 用法（与官方一致的追加方式）：
+#   make ARCH=arm64 ruby_defconfig
+#   make ARCH=arm64 vendor/hyperos.config
+#
+# 请按需逐项注释后单独出包，用于二分定位真正的阻塞项。
+
+# --- MTK 性能 / 调度框架 ---
+CONFIG_MTK_FPSGO_V3=y
+CONFIG_MTK_PERF_OBSERVER=y
+CONFIG_MTK_LOAD_TRACKER=y
+CONFIG_MTK_CPU_CTRL_CFP=y
+CONFIG_MTK_FRS=y
+CONFIG_MTK_RESYM=y
+
+# --- MTK 遥测 / 日志 ---
+CONFIG_MTK_MET=y
+CONFIG_MTK_MET_PLF=m
+CONFIG_MTPROF=y
+CONFIG_MTK_GZ_LOG=y
+
+# --- 调试设施（debugfs / tracefs）---
+CONFIG_DEBUG_FS=y
+CONFIG_TRACING=y
+
+# --- 符号表（KPatch / 部分 vendor 调试依赖）---
+CONFIG_KALLSYMS_ALL=y
\ No newline at end of file
-- 
2.43.0


From b5775d39ba9641413f997595321b5cebeba2da1a Mon Sep 17 00:00:00 2001
From: MoonWake Builder <builder@localhost>
Date: Sat, 3 Oct 2026 00:19:52 +0000
Subject: [PATCH 2/2] kernelsu: integrate official KernelSU v0.9.5 (non-GKI
 manual hooks)

Replace the KernelSU-Next hook glue with the interfaces expected by the
official KernelSU v0.9.5 kernel source (drivers/kernelsu -> KernelSU/kernel):

- fs/exec.c:     drop ksu_su_compat_enabled gate, call ksu_handle_execveat /
                 ksu_handle_execveat_sucompat as documented for non-GKI.
- fs/stat.c:     drop ksu_handle_newfstat_ret / ksu_handle_fstat64_ret
                 (KernelSU-Next only); keep ksu_handle_stat.
- kernel/reboot.c: drop ksu_handle_sys_reboot (KernelSU-Next only).
- drivers/Kconfig/Makefile: wire up drivers/kernelsu.
- vendor/official-ksu.config: CONFIG_KSU=y and explicitly keep KPROBES
  disabled, which v0.9.5 requires for the manual-hook path.

Link stage previously failed with undefined ksu_execveat_hook /
ksu_vfs_read_hook / ksu_input_hook because CONFIG_KPROBES=y made ksud.c
compile the kprobe branch instead of defining those manual-hook globals.
---
 arch/arm64/configs/vendor/official-ksu.config | 27 +++++++++++++++++++
 drivers/Kconfig                               |  2 ++
 drivers/Makefile                              |  4 ++-
 fs/exec.c                                     | 17 +++---------
 fs/stat.c                                     | 15 -----------
 kernel/reboot.c                               | 12 ---------
 6 files changed, 36 insertions(+), 41 deletions(-)
 create mode 100644 arch/arm64/configs/vendor/official-ksu.config

diff --git a/arch/arm64/configs/vendor/official-ksu.config b/arch/arm64/configs/vendor/official-ksu.config
new file mode 100644
index 000000000000..78f1217bdb83
--- /dev/null
+++ b/arch/arm64/configs/vendor/official-ksu.config
@@ -0,0 +1,27 @@
+# 官方 KernelSU (tiann/KernelSU) 内置配置
+#
+# 说明：
+#   官方 KernelSU 自 v1.0 起放弃非 GKI 内核支持，最后一个支持 4.19 的版本是 v0.9.5。
+#   本内核树内 KernelSU/kernel 即 v0.9.5（非 GKI 手动集成方式）。
+#
+# 关键点：必须保持 KPROBES 关闭！
+#   v0.9.5 的 ksud.c 中：
+#     #ifdef CONFIG_KPROBES
+#     ...（kprobe 模式，不定义 ksu_*_hook 变量）
+#     #else
+#     bool ksu_vfs_read_hook / ksu_execveat_hook / ksu_input_hook = true;  ← 手动模式
+#     #endif
+#   内核树内的手动埋点（fs/exec.c、fs/open.c、fs/stat.c、fs/read_write.c、
+#   drivers/input/input.c）依赖这些变量，只有 KPROBES=n 时才存在，否则链接失败。
+#   官方 non-GKI 文档亦明确：手动集成必须关闭 CONFIG_KPROBES，
+#   否则开机后按音量下可能误触发安全模式。
+#   （ruby_defconfig 本身即为 CONFIG_KPROBES=n，此处显式声明以防被其它片段打开。）
+#
+# 其它依赖（已满足）：
+#   - CONFIG_OVERLAY_FS：KSU Kconfig `depends on OVERLAY_FS`
+#   - CONFIG_MODULES / CONFIG_KALLSYMS
+#
+CONFIG_KPROBES=n
+CONFIG_HAVE_KPROBES=n
+CONFIG_KPROBE_EVENTS=n
+CONFIG_KSU=y
\ No newline at end of file
diff --git a/drivers/Kconfig b/drivers/Kconfig
index 316cdc3151e9..9a1250065d54 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -226,4 +226,6 @@ source "drivers/slimbus/Kconfig"
 source "drivers/interconnect/Kconfig"
 
 source "drivers/energy_model/Kconfig"
+
+source "drivers/kernelsu/Kconfig"
 endmenu
diff --git a/drivers/Makefile b/drivers/Makefile
index 18ac7061caa7..48c034ec547b 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -189,5 +189,7 @@ obj-$(CONFIG_TEE)		+= tee/
 obj-$(CONFIG_MULTIPLEXER)	+= mux/
 obj-$(CONFIG_UNISYS_VISORBUS)	+= visorbus/
 obj-$(CONFIG_SIOX)		+= siox/
-obj-$(CONFIG_GNSS)		+= gnss/
+obj-$(CONFIG_GNSS)              += gnss/
 obj-$(CONFIG_INTERCONNECT)     += interconnect/
+
+obj-$(CONFIG_KSU)              += kernelsu/
diff --git a/fs/exec.c b/fs/exec.c
index 00ff9c17e71b..4ee4fb8fc4b8 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1732,12 +1732,10 @@ static int exec_binprm(struct linux_binprm *bprm)
  */
 #ifdef CONFIG_KSU
 extern bool ksu_execveat_hook __read_mostly;
-extern bool ksu_su_compat_enabled __read_mostly;
-extern bool __ksu_is_allow_uid_for_current(uid_t uid);
 extern int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv,
 			void *envp, int *flags);
-extern int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr, void *argv,
-				void *envp, int *flags);
+extern int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
+				void *argv, void *envp, int *flags);
 #endif
 
 static int __do_execve_file(int fd, struct filename *filename,
@@ -1753,17 +1751,10 @@ static int __do_execve_file(int fd, struct filename *filename,
 	if (IS_ERR(filename))
 		return PTR_ERR(filename);
 #ifdef CONFIG_KSU
-	if (!ksu_su_compat_enabled) {
-		goto orig_flow;
-	}
-
-	if (unlikely(ksu_execveat_hook)) {
+	if (unlikely(ksu_execveat_hook))
 		ksu_handle_execveat(&fd, &filename, &argv, &envp, &flags);
-	} else if ((__ksu_is_allow_uid_for_current(current_uid().val))) {
+	else
 		ksu_handle_execveat_sucompat(&fd, &filename, &argv, &envp, &flags);
-	}
-
-orig_flow:
 #endif
 	/*
 	 * We move the actual failure in case of RLIMIT_NPROC excess from
diff --git a/fs/stat.c b/fs/stat.c
index 3450efdccfd7..ad13d8c38c9f 100644
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -380,13 +380,6 @@ extern int ksu_handle_stat(int *dfd, const char __user **filename_user,
  int *flags);
 #endif
 
-#if defined(CONFIG_KSU) && !defined(CONFIG_KSU_KPROBES_KSUD)
-extern void ksu_handle_newfstat_ret(unsigned int *fd, struct stat __user **statbuf_ptr);
-#if defined(__ARCH_WANT_STAT64) || defined(__ARCH_WANT_COMPAT_STAT64)
-extern void ksu_handle_fstat64_ret(unsigned long *fd, struct stat64 __user **statbuf_ptr); // for 32-bit
-#endif
-#endif
-
 #if !defined(__ARCH_WANT_STAT64) || defined(__ARCH_WANT_SYS_NEWFSTATAT)
 SYSCALL_DEFINE4(newfstatat, int, dfd, const char __user *, filename,
 		struct stat __user *, statbuf, int, flag)
@@ -411,10 +404,6 @@ SYSCALL_DEFINE2(newfstat, unsigned int, fd, struct stat __user *, statbuf)
 	if (!error)
 		error = cp_new_stat(&stat, statbuf);
 
-#if defined(CONFIG_KSU) && !defined(CONFIG_KSU_KPROBES_KSUD)
-	ksu_handle_newfstat_ret(&fd, &statbuf);
-#endif
-	
 	return error;
 }
 
@@ -541,10 +530,6 @@ SYSCALL_DEFINE2(fstat64, unsigned long, fd, struct stat64 __user *, statbuf)
 	if (!error)
 		error = cp_new_stat64(&stat, statbuf);
 
-#if defined(CONFIG_KSU) && !defined(CONFIG_KSU_KPROBES_KSUD) // for 32-bit
-	ksu_handle_fstat64_ret(&fd, &statbuf);
-#endif
-	
 	return error;
 }
 
diff --git a/kernel/reboot.c b/kernel/reboot.c
index cdae8c9b3e9e..3875bd6bdeda 100644
--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -306,9 +306,6 @@ DEFINE_MUTEX(system_transition_mutex);
  * reboot doesn't sync: do that yourself before calling this.
  */
 
-#ifdef CONFIG_KSU
-extern int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd, void __user **arg);
-#endif
 SYSCALL_DEFINE4(reboot, int, magic1, int, magic2, unsigned int, cmd,
 		void __user *, arg)
 {
@@ -316,15 +313,6 @@ SYSCALL_DEFINE4(reboot, int, magic1, int, magic2, unsigned int, cmd,
 	char buffer[256];
 	int ret = 0;
 
-#ifdef CONFIG_KSU
-	ret = ksu_handle_sys_reboot(magic1, magic2, cmd, &arg);
-	if (ret) {
-		goto orig_flow;
-	}
-	return ret;
-orig_flow:
-#endif
-
 	/* We only trust the superuser with rebooting the system. */
 	if (!ns_capable(pid_ns->user_ns, CAP_SYS_BOOT))
 		return -EPERM;
