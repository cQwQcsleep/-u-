+}
+
+static int decode_any(
+	const uint8_t *in_at,
+	const uint8_t *const out0,
+	uint8_t *const out,
+	const uint8_t *const in_end,
+	const uint8_t *const out_end,
+	const uint_fast32_t nr_log2,
+	const uint_fast32_t off_log2)
