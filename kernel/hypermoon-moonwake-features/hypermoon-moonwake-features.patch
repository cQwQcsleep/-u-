+			 (uint8_t*)out, (const uint8_t*)in + in_max, (uint8_t*)out + out_max);
+}
+EXPORT_SYMBOL(lz4kd_decode_delta);
+
+MODULE_LICENSE("Dual BSD/GPL");
+MODULE_DESCRIPTION("LZ4K decoder");
